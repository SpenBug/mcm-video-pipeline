      "duration_frames": 189,
      "sentences": [
        {
          "text": "先把关键参数挑出来。",
          "start": 6.73,
          "end": 8.34
        },
        {
          "text": "不是所有参数都值得扰动，",
          "start": 8.46,
          "end": 10.42
        },
        {
          "text": "挑那些量级不确定、来源存疑的。",
          "start": 10.54,
          "end": 13.04
        }
      ]
    },
    {
      "name": "s2",
      "start_sec": 13.46,
      "duration_sec": 5.95,
      "start_frame": 404,
      "duration_frames": 178,
      "sentences": [
        {
          "text": "各扰动正负百分之二十，重跑一遍。",
          "start": 13.46,
          "end": 15.96
        },
        {
          "text": "看排序变不变，",
          "start": 16.08,
          "end": 17.15
        },
        {
          "text": "排序变了，结论就不能进摘要。",
          "start": 17.27,
          "end": 19.41
        }
      ]
    },
    {
      "name": "s3",
      "start_sec": 19.83,
      "duration_sec": 7.38,
      "start_frame": 595,
      "duration_frames": 221,
      "sentences": [
        {
          "text": "灵敏度不是换个数字再算一遍。",
          "start": 19.83,
          "end": 22.15
        },
        {
          "text": "它是一次压力测试：",
          "start": 22.27,
          "end": 23.88
        },
        {
          "text": "如果模型扛不住，说明你对它的信心是假的。",
          "start": 24.0,
          "end": 27.21
        }
      ]
    },
